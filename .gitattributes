# Normalize line endings for this static site.
# Store text as LF and check out as LF everywhere, so Git on Windows
# stops warning that "LF will be replaced by CRLF".
* text=auto eol=lf

# Web/text source: always LF
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.svg   text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.webmanifest text eol=lf

# Binary assets: never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
